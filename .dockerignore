# Version control
.git
.gitignore

# Dependencies (reinstalled inside the image)
node_modules

# Next.js build output (rebuilt inside the image)
.next

# Local env overrides — never bake secrets into the image
.env
.env.*
!.env.example

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Dev / editor artifacts
.vscode
.idea
*.log
npm-debug.log*

# Docs
*.md
